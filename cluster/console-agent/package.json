{
  "name": "@octelium/console-agent",
  "version": "0.1.0",
  "description": "The Octelium web console AI agent that runs inside a Cordium Workspace",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octelium/octelium-ee.git",
    "directory": "cluster/console-agent"
  },
  "bin": {
    "octelium-console-agent": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    }
  },
  "files": [
    "dist",
    "apis",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:publish": "node --test scripts/publish-version.test.mjs",
    "fmt": "prettier --write src",
    "protoc": "mkdir -p ./apis && protoc --proto_path ../../ --include_imports --include_source_info --descriptor_set_out ./apis/octelium.binpb apis/protobuf/main/corev1/corev1.proto apis/protobuf/main/userv1/userv1.proto apis/protobuf/main/enterprisev1/enterprisev1.proto apis/protobuf/main/accessv1/accessv1.proto apis/protobuf/main/cordiumv1/cordiumv1.proto apis/protobuf/main/visibilityv1/visibilityv1.proto apis/protobuf/main/visibilityv1/core/vcorev1.proto apis/protobuf/main/visibilityv1/enterprise/venterprisev1.proto apis/protobuf/main/visibilityv1/access/vaccessv1.proto apis/protobuf/main/visibilityv1/cordium/vcordiumv1.proto apis/protobuf/main/visibilityv1/metrics/vmetricsv1.proto apis/protobuf/main/visibilityv1/llm/vllmv1.proto"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "@earendil-works/pi-ai": "1.0.1",
    "@earendil-works/pi-coding-agent": "1.0.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "semver": "7.8.5",
    "typescript": "~6.0.3"
  }
}
