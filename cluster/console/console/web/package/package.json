{
  "name": "octelium-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "SEE LICENSE in LICENSE",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "build-dev": "tsc && vite build --mode development",
    "build-staging": "tsc && vite build --mode staging",
    "protoc-gen-user": "npx protoc --ts_out ./tmp --ts_opt long_type_number --proto_path ../../../../../ apis/protobuf/main/userv1/userv1.proto",
    "protoc-gen-core": "npx protoc --ts_out ./tmp --ts_opt long_type_number --proto_path ../../../../../ apis/protobuf/main/corev1/corev1.proto",
    "protoc-gen-ee": "npx protoc --ts_out ./tmp --ts_opt long_type_number --proto_path ../../../../../ apis/protobuf/main/enterprisev1/enterprisev1.proto",
    "protoc-gen-access": "npx protoc --ts_out ./tmp --ts_opt long_type_number --proto_path ../../../../../ apis/protobuf/main/accessv1/accessv1.proto",
    "protoc-gen-meta": "npx protoc --ts_out ./tmp --ts_opt long_type_number --proto_path ../../../../../ apis/protobuf/main/metav1/metav1.proto",
    "protoc-gen-auth": "npx protoc --ts_out ./tmp --ts_opt long_type_number --proto_path ../../../../../ apis/protobuf/main/authv1/authv1.proto",
    "protoc-gen-visibility": "npx protoc --ts_out ./tmp --ts_opt long_type_number --proto_path ../../../../../ apis/protobuf/main/visibilityv1/visibilityv1.proto",
    "protoc-gen-visibility-m": "npx protoc --ts_out ./tmp --ts_opt long_type_number --proto_path ../../../../../ apis/protobuf/main/visibilityv1/meta/vmetav1.proto",
    "protoc-gen-visibility-n": "npx protoc --ts_out ./tmp --ts_opt long_type_number --proto_path ../../../../../ apis/protobuf/main/visibilityv1/core/vcorev1.proto",
    "protoc-gen-visibility-e": "npx protoc --ts_out ./tmp --ts_opt long_type_number --proto_path ../../../../../ apis/protobuf/main/visibilityv1/enterprise/venterprisev1.proto",
    "protoc-gen-visibility-a": "npx protoc --ts_out ./tmp --ts_opt long_type_number --proto_path ../../../../../ apis/protobuf/main/visibilityv1/access/vaccessv1.proto",
    "protoc-gen-visibility-metrics": "npx protoc --ts_out ./tmp --ts_opt long_type_number --proto_path ../../../../../ apis/protobuf/main/visibilityv1/metrics/vmetricsv1.proto",
    "protoc-gen": "mkdir -p ./tmp/apis/protobuf && npm run protoc-gen-meta && npm run protoc-gen-user && npm run protoc-gen-core && npm run protoc-gen-auth && npm run protoc-gen-ee && npm run protoc-gen-access && npm run protoc-gen-visibility && npm run protoc-gen-visibility-m && npm run protoc-gen-visibility-a && npm run protoc-gen-visibility-e && npm run protoc-gen-visibility-n && npm run protoc-gen-visibility-metrics",
    "protoc-cp": "cp -r ./tmp/apis/protobuf/main/metav1 ./src/apis && cp -r ./tmp/apis/protobuf/main/userv1 ./src/apis && cp -r ./tmp/apis/protobuf/main/corev1 ./src/apis && cp -r ./tmp/apis/protobuf/main/authv1 ./src/apis && cp -r ./tmp/apis/protobuf/main/enterprisev1 ./src/apis && cp -r ./tmp/apis/protobuf/main/accessv1 ./src/apis && cp -r ./tmp/apis/protobuf/main/visibilityv1 ./src/apis",
    "protoc-fix": "find ./src/apis -name '*.ts' -exec sed -i s#../../../../google/protobuf#../google/protobuf#g {} +",
    "cleanup-pf": "find ./src/apis -type f -name '*.proto' -exec rm {} +",
    "protoc": "npm run protoc-gen && npm run protoc-cp && npm run protoc-fix && npm run cleanup-pf"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@apidevtools/json-schema-ref-parser": "^16.0.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource/ubuntu": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@mantine/charts": "^9.5.2",
    "@mantine/core": "^9.5.2",
    "@mantine/dates": "^9.5.2",
    "@mantine/form": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@protobuf-ts/grpcweb-transport": "^2.11.1",
    "@protobuf-ts/plugin": "^2.11.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@reduxjs/toolkit": "^2.12.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.102.3",
    "@uiw/codemirror-extensions-langs": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror-json-schema": "^0.8.1",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "echarts-for-react": "3.0.6",
    "flag-icons": "^7.5.0",
    "framer-motion": "^13.1.1",
    "i18n-iso-countries": "^7.14.0",
    "js-yaml": "^4.3.0",
    "lucide-react": "^1.34.0",
    "nanoevents": "^10.0.0",
    "next-themes": "^0.4.6",
    "openai": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "react-spinners": "^0.17.0",
    "reconnecting-websocket": "^4.4.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "truncate": "^3.0.0",
    "truncate-utf8-bytes": "^1.0.2",
    "ts-pattern": "^5.9.0",
    "vaul": "^1.1.2",
    "vite-plugin-svgr": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/truncate-utf8-bytes": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "~6.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
