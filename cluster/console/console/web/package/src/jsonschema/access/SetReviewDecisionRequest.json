{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$ref": "#/definitions/SetReviewDecisionRequest",
    "definitions": {
        "SetReviewDecisionRequest": {
            "properties": {
                "requestRef": {
                    "$ref": "#/definitions/octelium.api.main.meta.v1.ObjectReference",
                    "additionalProperties": false,
                    "description": "RequestRef is the reference of the reviewed Request. Required."
                },
                "decision": {
                    "enum": [
                        "DECISION_UNSET",
                        "DECISION_APPROVE",
                        "DECISION_REJECT"
                    ],
                    "type": "string",
                    "title": "Decision",
                    "description": "Decision is the reviewer's decision on the Request"
                },
                "justification": {
                    "type": "string",
                    "description": "Justification is the reviewer's free-form explanation of the decision. It cannot be longer than 1500 characters."
                },
                "expectedStepName": {
                    "type": "string",
                    "description": "ExpectedStepName is an optional safety check. If it is set and the Request is no longer waiting for that review Step, the decision is rejected instead of being applied to another Step."
                },
                "expectedSpecRevision": {
                    "type": "integer",
                    "description": "ExpectedSpecRevision is an optional safety check. If it is set and the Request's `status.specRevision` differs from it (i.e. the requester changed the Request after the reviewer read it), the decision is rejected."
                },
                "duration": {
                    "$ref": "#/definitions/octelium.api.main.meta.v1.Duration",
                    "additionalProperties": false,
                    "description": "Duration narrows the access duration of an approval. It cannot exceed the Request's effective duration and it must not be set for the other decisions."
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Set Review Decision Request",
            "description": "SetReviewDecisionRequest is the request of the SetReviewDecision method."
        },
        "octelium.api.main.meta.v1.Duration": {
            "properties": {
                "milliseconds": {
                    "type": "integer",
                    "description": "Milliseconds is the duration set in milliseconds"
                },
                "seconds": {
                    "type": "integer",
                    "description": "Seconds is the duration set in seconds"
                },
                "minutes": {
                    "type": "integer",
                    "description": "Minutes is the duration set in minutes"
                },
                "hours": {
                    "type": "integer",
                    "description": "Hours is the duration set in hours"
                },
                "days": {
                    "type": "integer",
                    "description": "Days is the duration set in days"
                },
                "weeks": {
                    "type": "integer",
                    "description": "Weeks is the duration set in weeks"
                },
                "months": {
                    "type": "integer",
                    "description": "Months is the duration set in months"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "allOf": [
                {
                    "oneOf": [
                        {
                            "not": {
                                "anyOf": [
                                    {
                                        "required": [
                                            "milliseconds"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "seconds"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "minutes"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "hours"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "days"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "weeks"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "months"
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "required": [
                                "milliseconds"
                            ]
                        },
                        {
                            "required": [
                                "seconds"
                            ]
                        },
                        {
                            "required": [
                                "minutes"
                            ]
                        },
                        {
                            "required": [
                                "hours"
                            ]
                        },
                        {
                            "required": [
                                "days"
                            ]
                        },
                        {
                            "required": [
                                "weeks"
                            ]
                        },
                        {
                            "required": [
                                "months"
                            ]
                        }
                    ]
                }
            ],
            "title": "Duration",
            "description": "Duration is a length of time that is expressed in a single unit of choice. Exactly one of the units is set (e.g. `seconds: 30`)."
        },
        "octelium.api.main.meta.v1.ObjectReference": {
            "properties": {
                "apiVersion": {
                    "type": "string",
                    "description": "APIVersion is the API version of the reference resource"
                },
                "kind": {
                    "type": "string",
                    "description": "Kind is the resource kind. A kind is unique per an APIVersion."
                },
                "uid": {
                    "type": "string",
                    "description": "UID is the resource object UID. A UID is unique across the entire Cluster."
                },
                "name": {
                    "type": "string",
                    "description": "Name is the resource object name. A name is unique per a certain kind."
                },
                "resourceVersion": {
                    "type": "string",
                    "description": "ResourceVersion is the resourceVersion of the resource."
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Object Reference",
            "description": "ObjectReference is a reference to another Cluster resource. It identifies the referenced resource by its kind and either its UID or its name."
        }
    }
}