        "octelium.api.main.core.v1.Condition": {
            "properties": {
                "matchAny": {
                    "type": "boolean",
                    "description": "MatchAny matches anything"
                },
                "match": {
                    "type": "string",
                    "description": "Match contains a single CEL expression"
                },
                "all": {
                    "$ref": "#/definitions/octelium.api.main.core.v1.Condition.All",
                    "additionalProperties": false,
                    "description": "All acts as a logical AND operator on its list of CEL expressions"
                },
                "any": {
                    "$ref": "#/definitions/octelium.api.main.core.v1.Condition.Any",
                    "additionalProperties": false,
                    "description": "Any acts as a logical OR operator on its list of CEL expressions"
                },
                "not": {
                    "type": "string",
                    "description": "Not acts as a logical NOT operator of a single CEL expression"
                },
                "none": {
                    "$ref": "#/definitions/octelium.api.main.core.v1.Condition.None",
                    "additionalProperties": false,
                    "description": "None acts as a logical NOR operator on its list of CEL expressions (i.e. none of the expressions matches)"
                },
                "opa": {
                    "$ref": "#/definitions/octelium.api.main.core.v1.Condition.OPA",
                    "additionalProperties": false,
                    "description": "OPA contains an OPA (Open Policy Agent) Rego script"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "allOf": [
                {
                    "oneOf": [
                        {
                            "not": {
                                "anyOf": [
                                    {
                                        "required": [
                                            "matchAny"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "match"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "all"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "any"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "not"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "none"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "opa"
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "required": [
                                "matchAny"
                            ]
                        },
                        {
                            "required": [
                                "match"
                            ]
                        },
                        {
                            "required": [
                                "all"
                            ]
                        },
                        {
                            "required": [
                                "any"
                            ]
                        },
                        {
                            "required": [
                                "not"
                            ]
                        },
                        {
                            "required": [
                                "none"
                            ]
                        },
                        {
                            "required": [
                                "opa"
                            ]
                        }
                    ]
                }
            ],
            "title": "Condition",
            "description": "Condition is a policy-as-code expression that is evaluated against the request context. It is used by the Policy rules, the Service dynamic configuration rules, the HTTP Plugins as well as by the IdentityProvider rules."
        },
        "octelium.api.main.core.v1.Condition.All": {
            "properties": {
                "of": {
                    "items": {
                        "$ref": "#/definitions/octelium.api.main.core.v1.Condition"
                    },
                    "additionalProperties": false,
                    "type": "array",
                    "description": "Of is the list of the Conditions that must all match"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "All",
            "description": "All acts as a logical AND operator on its list of Conditions"
        },
        "octelium.api.main.core.v1.Condition.Any": {
            "properties": {
                "of": {
                    "items": {
                        "$ref": "#/definitions/octelium.api.main.core.v1.Condition"
                    },
                    "additionalProperties": false,
                    "type": "array",
                    "description": "Of is the list of the Conditions of which at least one must match"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Any",
            "description": "Any acts as a logical OR operator on its list of Conditions"
        },
        "octelium.api.main.core.v1.Condition.None": {
            "properties": {
                "of": {
                    "items": {
                        "$ref": "#/definitions/octelium.api.main.core.v1.Condition"
                    },
                    "additionalProperties": false,
                    "type": "array",
                    "description": "Of is the list of the Conditions of which none must match"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "None",
            "description": "None acts as a logical NOR operator on its list of Conditions"
        },
        "octelium.api.main.core.v1.Condition.OPA": {
            "properties": {
                "inline": {
                    "type": "string",
                    "description": "Inline is the OPA Rego script directly provided as a string"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "allOf": [
                {
                    "oneOf": [
                        {
                            "not": {
                                "anyOf": [
                                    {
                                        "required": [
                                            "inline"
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "required": [
                                "inline"
                            ]
                        }
                    ]
                }
            ],
            "title": "OPA",
            "description": "OPA evaluates the Condition via an Open Policy Agent Rego script"
        },
        "octelium.api.main.core.v1.InlinePolicy": {
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name is the name of the inline Policy"
                },
                "spec": {
                    "$ref": "#/definitions/octelium.api.main.core.v1.Policy.Spec",
                    "additionalProperties": false,
                    "description": "Spec is the Policy spec"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Inline Policy",
            "description": "InlinePolicy is a Policy that is defined inline within the resource that attaches it instead of being created as a standalone Policy resource."
        },
        "octelium.api.main.core.v1.Policy.Spec": {
            "properties": {
                "rules": {
                    "items": {
                        "$ref": "#/definitions/octelium.api.main.core.v1.Policy.Spec.Rule"
                    },
                    "additionalProperties": false,
                    "type": "array",
                    "description": "Rules is the list of Policy rules"
                },
                "enforcementRules": {
                    "items": {
                        "$ref": "#/definitions/octelium.api.main.core.v1.Policy.Spec.EnforcementRule"
                    },
                    "additionalProperties": false,
                    "type": "array",
                    "description": "EnforcementRules is the list of enforcement rules that are typically used as a precondition for using the Policy rules. You can simply extract your shared conditions from your rules and write them instead inside enforcementRules for better performance and readability"
                },
                "attrs": {
                    "additionalProperties": true,
                    "type": "object",
                    "description": "Attrs is a map of user-defined attributes that can be reused inside the Policy rules. It is strongly recommended to stick to camelCase in order to be conformant with Octelium's API naming conventions."
                },
                "isDisabled": {
                    "type": "boolean",
                    "description": "IsDisabled disables (i.e. deactivates) the Policy. You can use this to temporarily disable enforcing the Policy altogether instead of having to delete it or de-attach it from the different Resources attaching it."
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Spec",
            "description": "Spec is the Policy specification"
        },
        "octelium.api.main.core.v1.Policy.Spec.EnforcementRule": {
            "properties": {
                "condition": {
                    "$ref": "#/definitions/octelium.api.main.core.v1.Condition",
                    "additionalProperties": false,
                    "description": "Condition is the enforcement rule's Condition"
                },
                "effect": {
                    "enum": [
                        "EFFECT_UNKNOWN",
                        "ENFORCE",
                        "IGNORE"
                    ],
                    "type": "string",
                    "title": "Effect",
                    "description": "Effect is the decision of the EnforcementRule once its Condition matches"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Enforcement Rule",
            "description": "EnforcementRule is a pre-condition that decides whether the Policy is evaluated at all. If no EnforcementRule matches, or if the list of EnforcementRules is empty, then the Policy is enforced. ENFORCE rules always override IGNORE rules in the same way that DENY rules override ALLOW rules."
        },
        "octelium.api.main.core.v1.Policy.Spec.Rule": {
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name is an optional name for the rule. It is currently useful in Logs to understand which rule triggered the Policy."
                },
                "condition": {
                    "$ref": "#/definitions/octelium.api.main.core.v1.Condition",
                    "additionalProperties": false,
                    "description": "Condition is the rule's Condition that must match in order for the rule, and subsequently the Policy as whole, to match"
                },
                "effect": {
                    "enum": [
                        "EFFECT_UNKNOWN",
                        "ALLOW",
                        "DENY"
                    ],
                    "type": "string",
                    "title": "Effect",
                    "description": "Effect is the decision of the Rule once its Condition matches"
                },
                "priority": {
                    "type": "integer",
                    "description": "Priority is an integer that sets the rule priority level. The lower the number, the higher the priority. Currently the range of numbers is between -4 (i.e. the highest priority) and 4 (i.e. the lowest priority)."
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Rule",
            "description": "Rule is a single access control rule of the Policy"
        },
        "octelium.api.main.meta.v1.Duration": {
            "properties": {
                "milliseconds": {
                    "type": "integer",
                    "description": "Milliseconds is the duration set in milliseconds"
                },
                "seconds": {
                    "type": "integer",
                    "description": "Seconds is the duration set in seconds"
                },
                "minutes": {
                    "type": "integer",
                    "description": "Minutes is the duration set in minutes"
                },
                "hours": {
                    "type": "integer",
                    "description": "Hours is the duration set in hours"
                },
                "days": {
                    "type": "integer",
                    "description": "Days is the duration set in days"
                },
                "weeks": {
                    "type": "integer",
                    "description": "Weeks is the duration set in weeks"
                },
                "months": {
                    "type": "integer",
                    "description": "Months is the duration set in months"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "allOf": [
                {
                    "oneOf": [
                        {
                            "not": {
                                "anyOf": [
                                    {
                                        "required": [
                                            "milliseconds"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "seconds"
                                        ]
