{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$ref": "#/definitions/IsAuthorizedResponse",
    "definitions": {
        "IsAuthorizedResponse": {
            "properties": {
                "isAuthorized": {
                    "type": "boolean",
                    "description": "IsAuthorized is whether the access request is authorized."
                },
                "reason": {
                    "$ref": "#/definitions/octelium.api.main.core.v1.AccessLog.Entry.Common.Reason",
                    "additionalProperties": false,
                    "description": "Reason is the reason of the authorization decision (e.g. the Policy and rule that produced it)."
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Is Authorized Response",
            "description": "IsAuthorizedResponse is the response of the IsAuthorized method."
        },
        "octelium.api.main.core.v1.AccessLog.Entry.Common.Reason": {
            "properties": {
                "type": {
                    "enum": [
                        "TYPE_UNKNOWN_REASON",
                        "SESSION_NOT_ACTIVE",
                        "DEVICE_NOT_ACTIVE",
                        "USER_DEACTIVATED",
                        "SCOPE_UNAUTHORIZED",
                        "POLICY_MATCH",
                        "NO_POLICY_MATCH",
                        "SESSION_CLIENT_TYPE_INVALID",
                        "SESSION_LOCKED",
                        "USER_LOCKED",
                        "DEVICE_LOCKED",
                        "AUTHENTICATOR_AUTHENTICATION_REQUIRED",
                        "AUTHENTICATOR_REGISTRATION_REQUIRED",
                        "SESSION_EXPIRED",
                        "ACCESS_TOKEN_EXPIRED"
                    ],
                    "type": "string",
                    "title": "Type",
                    "description": "Type is the reason of the authorization decision"
                },
                "details": {
                    "$ref": "#/definitions/octelium.api.main.core.v1.AccessLog.Entry.Common.Reason.Details",
                    "additionalProperties": false,
                    "description": "Details is the type-specific details of the Reason"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Reason",
            "description": "Reason is why the request was allowed or denied"
        },
        "octelium.api.main.core.v1.AccessLog.Entry.Common.Reason.Details": {
            "properties": {
                "policyMatch": {
                    "$ref": "#/definitions/octelium.api.main.core.v1.AccessLog.Entry.Common.Reason.Details.PolicyMatch",
                    "additionalProperties": false,
                    "description": "PolicyMatch shows the details of the Policy rule that triggered the decision"
                },
                "sessionNotActive": {
                    "$ref": "#/definitions/octelium.api.main.core.v1.AccessLog.Entry.Common.Reason.Details.SessionNotActive",
                    "additionalProperties": false,
                    "description": "SessionNotActive shows the details of the Session that is not active"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "allOf": [
                {
                    "oneOf": [
                        {
                            "not": {
                                "anyOf": [
                                    {
                                        "required": [
                                            "policyMatch"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "sessionNotActive"
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "required": [
                                "policyMatch"
                            ]
                        },
                        {
                            "required": [
                                "sessionNotActive"
                            ]
                        }
                    ]
                }
            ],
            "title": "Details",
            "description": "Details is the type-specific details of the Reason"
        },
        "octelium.api.main.core.v1.AccessLog.Entry.Common.Reason.Details.PolicyMatch": {
            "properties": {
                "policy": {
                    "$ref": "#/definitions/octelium.api.main.core.v1.AccessLog.Entry.Common.Reason.Details.PolicyMatch.Policy",
                    "additionalProperties": false,
                    "description": "Policy is the standalone Policy whose rule match triggered the decision"
                },
                "inlinePolicy": {
                    "$ref": "#/definitions/octelium.api.main.core.v1.AccessLog.Entry.Common.Reason.Details.PolicyMatch.InlinePolicy",
                    "additionalProperties": false,
                    "description": "InlinePolicy is the inline Policy of a resource whose rule match triggered the decision"
                },
                "ruleName": {
                    "type": "string",
                    "description": "RuleName is the name of the Policy rule that matched, if available"
                },
                "priority": {
                    "type": "integer",
                    "description": "Priority is the priority level of the Policy rule that matched"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "allOf": [
                {
                    "oneOf": [
                        {
                            "not": {
                                "anyOf": [
                                    {
                                        "required": [
                                            "policy"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "inlinePolicy"
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "required": [
                                "policy"
                            ]
                        },
                        {
                            "required": [
                                "inlinePolicy"
                            ]
                        }
                    ]
                }
            ],
            "title": "Policy Match",
            "description": "PolicyMatch is the details of the Policy rule that triggered the authorization decision"
        },
        "octelium.api.main.core.v1.AccessLog.Entry.Common.Reason.Details.PolicyMatch.InlinePolicy": {
            "properties": {
                "resourceRef": {
                    "$ref": "#/definitions/octelium.api.main.meta.v1.ObjectReference",
                    "additionalProperties": false,
                    "description": "ResourceRef is the reference to the Resource whose inline Policy triggered the rule match"
                },
                "name": {
                    "type": "string",
                    "description": "Name is the name of the inline Policy if available"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Inline Policy",
            "description": "InlinePolicy is the inline Policy whose rule matched"
        },
        "octelium.api.main.core.v1.AccessLog.Entry.Common.Reason.Details.PolicyMatch.Policy": {
            "properties": {
                "policyRef": {
                    "$ref": "#/definitions/octelium.api.main.meta.v1.ObjectReference",
                    "additionalProperties": false,
                    "description": "PolicyRef is the reference to the Policy"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Policy",
            "description": "Policy is the standalone Policy whose rule matched"
        },
        "octelium.api.main.core.v1.AccessLog.Entry.Common.Reason.Details.SessionNotActive": {
            "properties": {
                "state": {
                    "enum": [
                        "STATE_UNKNOWN",
                        "ACTIVE",
                        "PENDING",
                        "REJECTED"
                    ],
                    "type": "string",
                    "title": "State",
                    "description": "State is the state of the Session"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Session Not Active",
            "description": "SessionNotActive is the details of a decision that was triggered by a Session that is not active"
        },
        "octelium.api.main.meta.v1.ObjectReference": {
            "properties": {
                "apiVersion": {
                    "type": "string",
                    "description": "APIVersion is the API version of the reference resource"
                },
                "kind": {
                    "type": "string",
                    "description": "Kind is the resource kind. A kind is unique per an APIVersion."
                },
                "uid": {
                    "type": "string",
                    "description": "UID is the resource object UID. A UID is unique across the entire Cluster."
                },
                "name": {
                    "type": "string",
                    "description": "Name is the resource object name. A name is unique per a certain kind."
                },
                "resourceVersion": {
                    "type": "string",
                    "description": "ResourceVersion is the resourceVersion of the resource."
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Object Reference",
            "description": "ObjectReference is a reference to another Cluster resource. It identifies the referenced resource by its kind and either its UID or its name."
        }
    }
}