        "octelium.api.main.core.v1.RequestContext.Request.HTTP": {
            "properties": {
                "headers": {
                    "additionalProperties": {
                        "type": "string"
                    },
                    "type": "object",
                    "description": "Headers is the map of HTTP request headers."
                },
                "method": {
                    "type": "string",
                    "description": "Method is the HTTP method (e.g. `GET`, `POST`)."
                },
                "path": {
                    "type": "string",
                    "description": "Path is the HTTP path without query params."
                },
                "host": {
                    "type": "string",
                    "description": "Host is the HTTP request `Host` or 'Authority` header value."
                },
                "protocol": {
                    "type": "string",
                    "description": "Protocol is the HTTP protocol (i.e. `HTTP/1.0`, `HTTP/1.1` or `HTTP/2`)"
                },
                "size": {
                    "type": "integer",
                    "description": "Size is the HTTP request size in bytes. If unknown, it must be -1."
                },
                "scheme": {
                    "type": "string",
                    "description": "Scheme is the request scheme"
                },
                "body": {
                    "type": "string",
                    "description": "Body is the request body",
                    "format": "binary",
                    "binaryEncoding": "base64"
                },
                "bodyMap": {
                    "additionalProperties": true,
                    "type": "object",
                    "description": "BodyMap is the serialized request body. Currently used with JSON."
                },
                "uri": {
                    "type": "string",
                    "description": "URI is the request path including the query"
                },
                "queryParams": {
                    "additionalProperties": {
                        "type": "string"
                    },
                    "type": "object",
                    "description": "QueryParams is the map of HTTP request query params. Params only assumes single-valued query params. If you want to check multi-valued params then you need to instead parse the URI field."
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "HTTP"
        },
        "octelium.api.main.core.v1.RequestContext.Request.Kubernetes": {
            "properties": {
                "http": {
                    "$ref": "#/definitions/octelium.api.main.core.v1.RequestContext.Request.HTTP",
                    "additionalProperties": false
                },
                "verb": {
                    "type": "string"
                },
                "apiPrefix": {
                    "type": "string"
                },
                "apiGroup": {
                    "type": "string"
                },
                "apiVersion": {
                    "type": "string"
                },
                "namespace": {
                    "type": "string"
                },
                "resource": {
                    "type": "string"
                },
                "subresource": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Kubernetes"
        },
        "octelium.api.main.core.v1.RequestContext.Request.LLM": {
            "properties": {
                "http": {
                    "$ref": "#/definitions/octelium.api.main.core.v1.RequestContext.Request.HTTP",
                    "additionalProperties": false,
                    "description": "HTTP is the underlying HTTP request details. The entire request body is available at `ctx.request.llm.http.bodyMap` which is used to access the messages (i.e. `ctx.request.llm.http.bodyMap.messages`) as well as any other field that is not normalized here."
                },
                "protocol": {
                    "enum": [
                        "PROTOCOL_UNSET",
                        "OPENAI",
                        "ANTHROPIC"
                    ],
                    "type": "string",
                    "title": "Protocol"
                },
                "operation": {
                    "enum": [
                        "OPERATION_UNSET",
                        "CHAT_COMPLETIONS",
                        "RESPONSES",
                        "COMPLETIONS",
                        "EMBEDDINGS",
                        "MODERATIONS",
                        "MODELS_LIST",
                        "MODELS_GET",
                        "MESSAGES",
                        "COUNT_TOKENS"
                    ],
                    "type": "string",
                    "title": "Operation"
                },
                "model": {
                    "type": "string",
                    "description": "Model is the model name requested by the downstream, verbatim. It is empty for the operations that carry no model (e.g. `MODELS_LIST`)."
                },
                "stream": {
                    "type": "boolean",
                    "description": "Stream is set for the requests that ask for a streamed response."
                },
                "estimatedInputTokens": {
                    "type": "integer",
                    "description": "EstimatedInputTokens is Octelium's own conservative pre-flight input token estimate. It is NOT a provider-accurate token count and it must never be treated as a billing truth. Read the EstimateQuality field alongside it."
                },
                "estimateQuality": {
                    "enum": [
                        "ESTIMATE_QUALITY_UNSET",
                        "COMPLETE",
                        "PARTIAL",
                        "UNAVAILABLE"
                    ],
                    "type": "string",
                    "title": "Estimate Quality"
                },
                "maxOutputTokens": {
                    "type": "integer",
                    "description": "MaxOutputTokens is the maximum output token count requested by the downstream itself. It is zero whenever the request declares none."
                },
                "hasTools": {
                    "type": "boolean",
                    "description": "HasTools is set for the requests that declare tools."
                },
                "toolCount": {
                    "type": "integer",
                    "description": "ToolCount is the number of the tools declared by the request."
                },
                "toolNames": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array",
                    "description": "ToolNames is the bounded list of the names of the tools declared by the request."
                },
                "inputItemCount": {
                    "type": "integer",
                    "description": "InputItemCount is the number of the input items (i.e. the messages or the embedding inputs) of the request."
                },
                "hasImageInput": {
                    "type": "boolean",
                    "description": "HasImageInput is set for the requests that carry image input."
                },
                "hasAudioInput": {
                    "type": "boolean",
                    "description": "HasAudioInput is set for the requests that carry audio input."
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "LLM"
        },
        "octelium.api.main.core.v1.RequestContext.Request.MCP": {
            "properties": {
                "http": {
                    "$ref": "#/definitions/octelium.api.main.core.v1.RequestContext.Request.HTTP",
                    "additionalProperties": false,
                    "description": "HTTP is the underlying HTTP request details. The entire JSON-RPC request body is available at `ctx.request.mcp.http.bodyMap` which is used to access the tool arguments (i.e. `ctx.request.mcp.http.bodyMap.params.arguments`) as well as any other field that is not normalized here."
                },
                "protocolVersion": {
                    "type": "string",
                    "description": "ProtocolVersion is the MCP protocol version declared by the request (e.g. \"2026-07-28\"). It is read from the request body's `io.modelcontextprotocol/protocolVersion` metadata field or from the `MCP-Protocol-Version` request header, and it is only set once both values are validated to match whenever both of them are present. It is empty for the protocol revisions that do not declare a version."
                },
                "method": {
                    "type": "string",
                    "description": "Method is the JSON-RPC method of the request body (e.g. `tools/call`, `resources/read`, `server/discover`)."
                },
                "name": {
                    "type": "string",
                    "description": "Name is the logical MCP target of the method whenever it has one. It is the tool name for `tools/call`, the prompt name for `prompts/get` and the resource URI for `resources/read`. It is empty for the methods that have no target such as the `*/list` methods."
                },
                "requestID": {
                    "type": "string",
                    "description": "RequestID is the JSON-RPC request `id` normalized into a string. It is controlled by the downstream and therefore it must never be used as a security identifier."
                },
                "isNotification": {
                    "type": "boolean",
                    "description": "IsNotification is set for JSON-RPC notifications (i.e. request bodies that carry no `id` and expect no response)."
                },
                "client": {
                    "$ref": "#/definitions/octelium.api.main.core.v1.RequestContext.Request.MCP.Client",
                    "additionalProperties": false,
                    "description": "Client is the client information reported by the downstream itself. It is useful for auditing and debugging and it is NOT an identity. Use the authenticated User, Session, Device and Groups for access control."
                },
                "capabilities": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array",
                    "description": "Capabilities is the list of the capability identifiers declared by the downstream for this request (e.g. \"elicitation\"). It is self-reported."
                },
                "sessionID": {
                    "type": "string",
                    "description": "SessionID is the value of the `Mcp-Session-Id` request header used by the protocol revisions between 2025-03-26 and 2025-11-25. It is an MCP transport identifier that is unrelated to the Octelium Session."
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "MCP"
        },
        "octelium.api.main.core.v1.RequestContext.Request.MCP.Client": {
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name is the name reported by the downstream client itself"
                },
                "version": {
                    "type": "string",
                    "description": "Version is the version reported by the downstream client itself"
                },
                "title": {
                    "type": "string",
                    "description": "Title is the human-readable title reported by the downstream client itself"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Client"
        },
        "octelium.api.main.core.v1.RequestContext.Request.Postgres": {
            "properties": {
                "connect": {
                    "$ref": "#/definitions/octelium.api.main.core.v1.RequestContext.Request.Postgres.Connect",
                    "additionalProperties": false
                },
                "query": {
                    "$ref": "#/definitions/octelium.api.main.core.v1.RequestContext.Request.Postgres.Query",
                    "additionalProperties": false
